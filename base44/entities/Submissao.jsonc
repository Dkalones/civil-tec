{
  "name": "Submissao",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "title": "T\u00edtulo do trabalho"
    },
    "autores": {
      "type": "string",
      "title": "Autores"
    },
    "email": {
      "type": "string",
      "title": "E-mail do autor respons\u00e1vel"
    },
    "area": {
      "type": "string",
      "title": "Eixo tem\u00e1tico",
      "enum": [
        "Estruturas",
        "Geotecnia",
        "Constru\u00e7\u00e3o e materiais",
        "Saneamento e recursos h\u00eddricos",
        "Transportes",
        "Tecnologia e inova\u00e7\u00e3o",
        "Sustentabilidade"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "green",
        "gray",
        "pink",
        "red"
      ]
    },
    "resumo": {
      "type": "string",
      "title": "Resumo"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Recebido",
        "Em avalia\u00e7\u00e3o",
        "Aprovado",
        "Reprovado"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green",
        "red"
      ],
      "default": "Recebido"
    }
  },
  "required": [
    "titulo",
    "autores",
    "email",
    "area",
    "resumo"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}